<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:PortShield.App.Controls"
             x:Class="PortShield.App.Views.OverviewView">
  <UserControl.Resources>
    <!-- Paired buttons share one width: Refresh / Scan, kill switch / whitelist mode (also after a language change) -->
    <x:Double x:Key="NoticeButtonWidth">132</x:Double>
    <x:Double x:Key="CardButtonWidth">236</x:Double>
  </UserControl.Resources>
  <ScrollViewer>
    <StackPanel Spacing="18" MaxWidth="1240" HorizontalAlignment="Stretch">

      <!-- Protection state -->
      <Border Classes="hero" Classes.ok="{Binding IsProtected}" Classes.warn="{Binding HasWarningOnly}" Classes.alert="{Binding HasAlert}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Panel Width="64" Height="64" Margin="0,0,20,0" VerticalAlignment="Center">
            <Border Classes="logoglow" Margin="4" />
            <Border Classes="logo" />
          </Panel>
          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <PathIcon Data="{StaticResource IconShieldCheck}" Width="22" Height="22" Foreground="{DynamicResource BrushSafe}" IsVisible="{Binding IsProtected}" />
              <PathIcon Data="{StaticResource IconShieldAlert}" Width="22" Height="22" Foreground="{DynamicResource BrushModerate}" IsVisible="{Binding HasWarningOnly}" />
              <PathIcon Data="{StaticResource IconShieldAlert}" Width="22" Height="22" Foreground="{DynamicResource BrushDeep}" IsVisible="{Binding HasAlert}" />
              <TextBlock Classes="h2" Text="{Binding HeroTitle}" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding HeroText}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{Binding OpenConsoleCommand}" ToolTip.Tip="{DynamicResource TipOpenConsole}">
              <ctl:IconLabel Icon="{StaticResource IconOpenInNew}" Text="{DynamicResource BtnOpenConsole}" />
            </Button>
            <Button Classes="primary" MinWidth="{StaticResource NoticeButtonWidth}" HorizontalContentAlignment="Center" Command="{Binding RefreshCommand}">
              <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnRefresh}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Notices -->
      <Border Classes="notice deep" IsVisible="{Binding ShowNotElevated}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{StaticResource IconAlert}" Width="18" Height="18" Foreground="{DynamicResource BrushDeep}" />
          <TextBlock Text="{DynamicResource NoticeNotElevated}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Classes="notice deep" IsVisible="{Binding ShowServiceStopped}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{StaticResource IconAlert}" Width="18" Height="18" Foreground="{DynamicResource BrushDeep}" />
          <TextBlock Text="{DynamicResource NoticeServiceStopped}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Classes="notice deep" IsVisible="{Binding ShowLocalRulesIgnored}">
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Data="{StaticResource IconAlert}" Width="18" Height="18" Foreground="{DynamicResource BrushDeep}" Margin="0,0,10,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource NoticeLocalIgnoredTitle}" />
            <TextBlock Text="{DynamicResource NoticeLocalIgnoredText}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Classes="notice deep" IsVisible="{Binding ShowProfileOff}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconShieldAlert}" Width="18" Height="18" Foreground="{DynamicResource BrushDeep}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{DynamicResource NoticeProfileOff}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Classes="primary" Margin="12,0,0,0" Command="{Binding EnableAllProfilesCommand}">
            <ctl:IconLabel Icon="{StaticResource IconShieldCheck}" Text="{DynamicResource BtnEnableAll}" />
          </Button>
        </Grid>
      </Border>
      <!-- Integrity check: PortShield rules removed or changed outside PortShield -->
      <Border Classes="notice deep" IsVisible="{Binding ShowDrift}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconShieldAlert}" Width="18" Height="18" Foreground="{DynamicResource BrushDeep}" Margin="0,0,10,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="4" ToolTip.Tip="{Binding DriftDetails}">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource NoticeDriftTitle}" />
            <TextBlock Text="{Binding DriftText}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
            <Button Command="{Binding AcceptDriftCommand}" ToolTip.Tip="{DynamicResource TipAcceptDrift}">
              <ctl:IconLabel Icon="{StaticResource IconCheck}" Text="{DynamicResource BtnAccept}" />
            </Button>
            <Button Classes="primary" Command="{Binding RestoreDriftCommand}">
              <ctl:IconLabel Icon="{StaticResource IconRestore}" Text="{DynamicResource BtnRestore}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <!-- Temporarily allowed rules -->
      <Border Classes="notice moderate" IsVisible="{Binding ShowTemporary}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconTimerSand}" Width="18" Height="18" Foreground="{DynamicResource BrushModerate}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding TemporaryText}" TextWrapping="Wrap" VerticalAlignment="Center" ToolTip.Tip="{Binding TemporaryDetails}" />
          <Button Grid.Column="2" Margin="12,0,0,0" Classes="danger" Command="{Binding BlockTemporaryNowCommand}">
            <ctl:IconLabel Icon="{StaticResource IconCancel}" Text="{DynamicResource BtnBlockAgainNow}" />
          </Button>
        </Grid>
      </Border>
      <!-- Watched rule sets with new programs -->
      <ItemsControl ItemsSource="{Binding WatchNotices}" IsVisible="{Binding HasWatchNotices}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="18" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="notice">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource IconEye}" Width="18" Height="18" Foreground="{DynamicResource BrushInfo}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                  <Button Command="{Binding $parent[UserControl].DataContext.IgnoreWatchCommand}" CommandParameter="{Binding}">
                    <ctl:IconLabel Icon="{StaticResource IconEyeOff}" Text="{DynamicResource BtnIgnore}" />
                  </Button>
                  <Button Classes="primary" Command="{Binding $parent[UserControl].DataContext.ApplyWatchCommand}" CommandParameter="{Binding}">
                    <ctl:IconLabel Icon="{StaticResource IconPlay}" Text="{DynamicResource BtnApply}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="notice moderate" IsVisible="{Binding ShowThirdParty}">
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Data="{StaticResource IconShieldAlert}" Width="18" Height="18" Foreground="{DynamicResource BrushModerate}" Margin="0,0,10,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource NoticeThirdPartyTitle}" />
            <TextBlock Text="{Binding ThirdPartyText}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Classes="notice" IsVisible="{Binding ShowUnmanaged}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <PathIcon Data="{StaticResource IconAnalyze}" Width="18" Height="18" Foreground="{DynamicResource BrushInfo}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding UnmanagedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="2" Margin="12,0,0,0" MinWidth="{StaticResource NoticeButtonWidth}" HorizontalContentAlignment="Center" Command="{Binding OpenScanCommand}">
            <ctl:IconLabel Icon="{StaticResource IconAnalyze}" Text="{DynamicResource BtnScan}" />
          </Button>
        </Grid>
      </Border>
      <Border Classes="notice" IsVisible="{Binding ShowPolicyManaged}">
        <Grid ColumnDefinitions="Auto,*">
          <PathIcon Data="{StaticResource IconServer}" Width="18" Height="18" Foreground="{DynamicResource BrushInfo}" Margin="0,0,10,0" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock FontWeight="SemiBold" Text="{DynamicResource NoticePolicyTitle}" />
            <TextBlock Text="{Binding PolicyText}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Rule counts (click: open the rules) -->
      <UniformGrid Columns="5" Margin="-6,0">
        <Button Classes="cardlink" Margin="6,0" Command="{Binding OpenRulesCommand}">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <PathIcon Data="{StaticResource IconWall}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentText}" HorizontalAlignment="Left" />
              <TextBlock Classes="kpi" Text="{Binding TotalRules}" Foreground="{DynamicResource BrushAccentText}" />
              <TextBlock Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccentText}" Text="{DynamicResource KpiTotal}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Button>
        <Button Classes="cardlink" Margin="6,0" Command="{Binding OpenRulesCommand}">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <PathIcon Data="{StaticResource IconArrowOut}" Width="20" Height="20" Foreground="{DynamicResource BrushDeep}" HorizontalAlignment="Left" />
              <TextBlock Classes="kpi" Text="{Binding BlockedOutbound}" Foreground="{DynamicResource BrushDeep}" />
              <TextBlock Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource BrushDeep}" Text="{DynamicResource KpiBlockedOut}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Button>
        <Button Classes="cardlink" Margin="6,0" Command="{Binding OpenRulesCommand}">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <PathIcon Data="{StaticResource IconArrowIn}" Width="20" Height="20" Foreground="{DynamicResource BrushDeep}" HorizontalAlignment="Left" />
              <TextBlock Classes="kpi" Text="{Binding BlockedInbound}" Foreground="{DynamicResource BrushDeep}" />
              <TextBlock Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource BrushDeep}" Text="{DynamicResource KpiBlockedIn}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Button>
        <Button Classes="cardlink" Margin="6,0" Command="{Binding OpenRulesCommand}">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <PathIcon Data="{StaticResource IconCheckCircle}" Width="20" Height="20" Foreground="{DynamicResource BrushSafe}" HorizontalAlignment="Left" />
              <TextBlock Classes="kpi" Text="{Binding AllowedRules}" Foreground="{DynamicResource BrushSafe}" />
              <TextBlock Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource BrushSafe}" Text="{DynamicResource KpiAllowed}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Button>
        <Button Classes="cardlink" Margin="6,0" Command="{Binding OpenRulesCommand}">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <PathIcon Data="{StaticResource IconEarth}" Width="20" Height="20" Foreground="{DynamicResource BrushModerate}" HorizontalAlignment="Left" />
              <TextBlock Classes="kpi" Text="{Binding InternetOnlyRules}" Foreground="{DynamicResource BrushModerate}" />
              <TextBlock Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource BrushModerate}" Text="{DynamicResource KpiInternetOnly}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Button>
      </UniformGrid>

      <Grid ColumnDefinitions="1.25*,18,*">
        <!-- Profiles -->
        <Border Classes="card" VerticalAlignment="Stretch">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <PathIcon Data="{StaticResource IconLan}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentText}" Margin="0,0,8,0" />
              <TextBlock Grid.Column="1" Classes="h2" Text="{DynamicResource HdrProfiles}" />
            </Grid>
            <TextBlock Classes="muted small" Text="{DynamicResource ProfilesHint}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="tablerow" Padding="4,10">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <Border Classes="badge accent" IsVisible="{Binding IsActive}">
                            <TextBlock Text="{DynamicResource BadgeActive}" />
                          </Border>
                          <Border Classes="badge info" IsVisible="{Binding ByPolicy}">
                            <TextBlock Text="{DynamicResource BadgePolicy}" />
                          </Border>
                          <Border Classes="badge block" IsVisible="{Binding LocalRulesIgnored}">
                            <TextBlock Text="{DynamicResource BadgeLocalIgnored}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="muted small">
                          <Run Text="{Binding OutboundText}" />
                          <Run Text=" · " />
                          <Run Text="{Binding InboundText}" />
                        </TextBlock>
                      </StackPanel>
                      <Border Grid.Column="1" Classes="badge allow" Margin="0,0,10,0" IsVisible="{Binding Enabled}">
                        <TextBlock Text="{Binding StateText}" />
                      </Border>
                      <Border Grid.Column="1" Classes="badge block" Margin="0,0,10,0" IsVisible="{Binding Disabled}">
                        <TextBlock Text="{Binding StateText}" />
                      </Border>
                      <Button Grid.Column="2" Classes="icon small" VerticalAlignment="Center"
                              Command="{Binding $parent[UserControl].DataContext.ToggleProfileCommand}" CommandParameter="{Binding}"
                              ToolTip.Tip="{DynamicResource TipToggleProfile}">
                        <PathIcon Data="{StaticResource IconPower}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Spacing="18">
          <!-- Kill switch -->
          <Border Classes="card killswitch" Classes.on="{Binding KillSwitchOn}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon Data="{StaticResource IconPower}" Width="20" Height="20" Foreground="{DynamicResource BrushDeep}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Classes="h2" Text="{DynamicResource HdrKillSwitch}" />
                <!-- State as coloured pill, right-aligned like the switch below: off green, active red -->
                <Border Grid.Column="2" Classes="pill" Background="{DynamicResource BrushSafeSoft}" IsVisible="{Binding !KillSwitchOn}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconCheckCircle}" Width="13" Height="13" Foreground="{DynamicResource BrushSafe}" />
                    <TextBlock Classes="small" FontWeight="SemiBold" Foreground="{DynamicResource BrushSafe}" Text="{DynamicResource KillSwitchPillOff}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="pill" Background="{DynamicResource BrushDanger}" IsVisible="{Binding KillSwitchOn}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconPower}" Width="13" Height="13" Foreground="#FFFFFF" />
                    <TextBlock Classes="small" FontWeight="SemiBold" Foreground="#FFFFFF" Text="{DynamicResource KillSwitchPillOn}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource LblKillSwitchLan}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding KillSwitchLan}" OnContent="" OffContent="" MinWidth="0" />
              </Grid>
              <Button HorizontalAlignment="Right" MinWidth="{StaticResource CardButtonWidth}" HorizontalContentAlignment="Center" Classes="danger" IsVisible="{Binding !KillSwitchOn}" Command="{Binding ToggleKillSwitchCommand}">
                <ctl:IconLabel Icon="{StaticResource IconPower}" Text="{Binding KillSwitchButton}" />
              </Button>
              <Button HorizontalAlignment="Right" MinWidth="{StaticResource CardButtonWidth}" HorizontalContentAlignment="Center" Classes="primary" IsVisible="{Binding KillSwitchOn}" Command="{Binding ToggleKillSwitchCommand}">
                <ctl:IconLabel Icon="{StaticResource IconPower}" Text="{Binding KillSwitchButton}" />
              </Button>
            </StackPanel>
          </Border>

          <!-- Whitelist mode -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Data="{StaticResource IconShieldLock}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentText}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Classes="h2" Text="{DynamicResource HdrWhitelist}" />
              </Grid>
              <TextBlock Text="{Binding WhitelistState}" FontWeight="SemiBold" />
              <TextBlock Classes="muted small" Text="{DynamicResource WhitelistHint}" TextWrapping="Wrap" />
              <Border Classes="notice" IsVisible="{Binding OutboundByPolicy}">
                <TextBlock Classes="small" Text="{DynamicResource WhitelistPolicyNote}" TextWrapping="Wrap" />
              </Border>
              <Button HorizontalAlignment="Right" MinWidth="{StaticResource CardButtonWidth}" HorizontalContentAlignment="Center" Command="{Binding ToggleWhitelistCommand}">
                <ctl:IconLabel Icon="{StaticResource IconShieldLock}" Text="{Binding WhitelistButton}" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- Quick actions -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconSpeed}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentText}" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Classes="h2" Text="{DynamicResource HdrQuickActions}" />
          </Grid>
          <WrapPanel HorizontalAlignment="Center">
            <Button Margin="4,0,4,8" Classes="primary" Command="{Binding AddApplicationCommand}">
              <ctl:IconLabel Icon="{StaticResource IconPlus}" Text="{DynamicResource BtnAddApplication}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding AddFolderCommand}">
              <ctl:IconLabel Icon="{StaticResource IconFolderOpen}" Text="{DynamicResource BtnAddFolder}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding AddProcessCommand}">
              <ctl:IconLabel Icon="{StaticResource IconApplication}" Text="{DynamicResource BtnAddProcess}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding OpenRuleSetsCommand}">
              <ctl:IconLabel Icon="{StaticResource IconBundle}" Text="{DynamicResource NavRuleSets}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding OpenExportCommand}">
              <ctl:IconLabel Icon="{StaticResource IconExport}" Text="{DynamicResource NavImportExport}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding SnapshotCommand}">
              <ctl:IconLabel Icon="{StaticResource IconBackup}" Text="{DynamicResource BtnSnapshot}" />
            </Button>
            <Button Margin="4,0,4,8" Classes="danger" Command="{Binding ResetFirewallCommand}">
              <ctl:IconLabel Icon="{StaticResource IconUndo}" Text="{DynamicResource BtnResetFirewall}" />
            </Button>
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
